# LiteLLM Rust Gateway Environment Configuration
# Copy to /etc/litellm/env and adjust secrets before starting litellm-gateway.service

HOST=0.0.0.0
PORT=4000
LITELLM_CONFIG=/etc/litellm/config.yaml
RUST_LOG=info

# Required for administrative/master access
LITELLM_MASTER_KEY=sk-replace-with-strong-master-key

# Optional PostgreSQL (Prisma schema) and Redis; omit for stateless mode
# DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/litellm
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Upstream Provider Keys (referenced via os.environ/VAR_NAME in config.yaml)
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# GEMINI_API_KEY=
# WOLINET_INFERENCE_URL=http://127.0.0.1:9997
