#!/usr/bin/env bash
# ==============================================================================
# Wolinet AI — Sovereign System CLI (wolinet-system)
# Unified entrypoint for stack status, synthetic golden loop probe,
# autonomous Pipeline 5 self-training, and multi-tier sync.
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

PYTHON_EXEC="python3"
if [ -x "${ROOT_DIR}/.venv/bin/python" ]; then
    PYTHON_EXEC="${ROOT_DIR}/.venv/bin/python"
elif [ -x "${ROOT_DIR}/services/litellm-memory/.venv/bin/python" ]; then
    PYTHON_EXEC="${ROOT_DIR}/services/litellm-memory/.venv/bin/python"
fi

export PYTHONPATH="${ROOT_DIR}:${PYTHONPATH:-}"
exec "${PYTHON_EXEC}" "${ROOT_DIR}/scripts/wolinet_system_ctl.py" "$@"
