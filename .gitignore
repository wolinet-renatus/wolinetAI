# Temporary UI Build Output (Exclude intermediate next export out)
gateway/ui/litellm-dashboard/out/
inference/frontend/out/

# Preserve Essential Embedded Production Distribution Bundles
!gateway/litellm/proxy/_experimental/out/
!gateway/litellm/proxy/_experimental/out/**
!inference/xinference/ui/web/dist/
!inference/xinference/ui/web/dist/**
!apps/web-client/dist/
!apps/web-client/dist/**
!packages/wolinet-sdk/dist/
!packages/wolinet-sdk/dist/**

# macOS / Swift Builds
*.app/
*.dSYM/
.build/
apps/desktop/Packages/
apps/desktop/.build/
xcuserdata/
DerivedData/

# Compiled Binaries (build locally from vendored source)
apps/cli/wolinet-cli
wolinet-cli

# Large Model Weights (Keep configuration JSONs, ignore raw weights)
models/*.gguf
models/*.bin
models/*.safetensors
models/*.pt
models/*.onnx
!models/registrations/

# Logs & Runtime Storage
*.log
logs/
*.pid
scratch/
.system_generated/
.tempmediaStorage/
.litespeed/

# Local Caches & Database files
*.sqlite
*.sqlite3
*.db
.litellm_cache/
