[Container]
ContainerName=wolinet-docs
Pod=wolinetai-core-pod
Image=docker.io/library/nginx:1.27-alpine
Volume=/var/lib/wolinet/apps/docs:/usr/share/nginx/html:ro
Volume=/var/lib/wolinet/apps/docs/nginx.conf:/etc/nginx/conf.d/default.conf:ro

[Service]
Restart=always

[Install]
WantedBy=default.target

