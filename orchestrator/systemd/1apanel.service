[Unit]
Description=Wolinet DEC 1Panel Control Plane & Hardware Supervisor
Documentation=https://wolinet.ai/docs
After=network.target network-online.target podman.socket
Wants=network-online.target podman.socket

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/wolinetai
ExecStartPre=/usr/bin/install -d -m 0755 -o root -g root /var/lib/wolinet /var/lib/wolinet/data/1panel/db
ExecStart=/opt/wolinetai/bin/1apanel
Restart=always
RestartSec=5s

# Environment Configuration
Environment=PANEL_BASE_DIR=/var/lib/wolinet/data
Environment=ORIGINAL_PORT=8888
Environment=DOCKER_HOST=unix:///run/podman/podman.sock
Environment=CONTAINER_HOST=unix:///run/podman/podman.sock

# Process & Resource Limits
LimitNOFILE=65535
LimitNPROC=65535
TasksMax=infinity
TimeoutStartSec=30s
TimeoutStopSec=30s

# Capabilities (Allow binding to privileged ports 80/443 and hardware inspection)
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SYS_ADMIN CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
