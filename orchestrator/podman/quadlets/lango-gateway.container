[Container]
ContainerName=wolinet-lango
Pod=wolinetai-core-pod
Image=ghcr.io/wolinet-renatus/wolinet-lango:latest
Volume=/var/lib/wolinet/gateway/config.yaml:/app/config.yaml:ro
Volume=/var/lib/wolinet/gateway/assets:/app/assets:ro
Environment=LITELLM_MASTER_KEY=sk-XvKFiwDoOtOe8i4lwbzb8Q
Environment=WOLINET_GATEWAY_MASTER_KEY=sk-XvKFiwDoOtOe8i4lwbzb8Q
Environment=UI_USERNAME=admin
Environment=UI_PASSWORD=Wolinet@2026!
Environment=LITELLM_CONFIG_PATH=/app/config.yaml
Environment=DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/litellm
Environment=REDIS_HOST=127.0.0.1
Environment=REDIS_PORT=6379
Environment=REDIS_PASSWORD=redis
Environment=REDIS_URL=redis://:redis@127.0.0.1:6379
Environment=WOLINET_API_BASE=http://127.0.0.1:9997/v1
Environment=WOLINET_INFERENCE_URL=http://127.0.0.1:9997
Environment=XINFERENCE_API_KEY=sk-XvKFiwDoOtOe8i4lwbzb8Q
Environment=OPENAI_API_KEY=sk-XvKFiwDoOtOe8i4lwbzb8Q
Environment=STORE_MODEL_IN_DB=true
Environment=DOCS_URL=/docs
Environment=ROOT_REDIRECT_URL=/ui
Exec=litellm --config /app/config.yaml --port 4000 --host 0.0.0.0

[Service]
Restart=always

[Install]
WantedBy=default.target
