[Container]
ContainerName=wolinet-postgres
Pod=wolinetai-core-pod
Image=docker.io/library/postgres:16-alpine
Volume=/var/lib/wolinet/data/postgres:/var/lib/postgresql/data:Z
Volume=/var/lib/wolinet/scripts/db/init-postgres.sh:/docker-entrypoint-initdb.d/00-init.sh:ro
Environment=POSTGRES_USER=postgres
Environment=POSTGRES_PASSWORD=postgres
Environment=POSTGRES_DB=litellm
Environment=PGDATA=/var/lib/postgresql/data/pgdata
Exec=postgres -c tcp_keepalives_idle=60 -c tcp_keepalives_interval=10 -c tcp_keepalives_count=5

[Service]
Restart=always

[Install]
WantedBy=default.target
