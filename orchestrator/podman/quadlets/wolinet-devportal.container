[Container]
ContainerName=wolinet-devportal
Pod=wolinetai-core-pod
Image=docker.io/library/nginx:1.27-alpine
Volume=/var/lib/wolinet/apps/dev-portal:/usr/share/nginx/html:ro
Volume=/var/lib/wolinet/apps/dev-portal/nginx.conf:/etc/nginx/conf.d/default.conf:ro

[Service]
Restart=always

[Install]
WantedBy=default.target
