# Dokploy production variables. Set real values in Dokploy secrets.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG_PASSWORD
# LiteLLM DB URL (used by 'lango' service)
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PG_PASSWORD@postgres:5432/litellm
LITELLM_DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PG_PASSWORD@postgres:5432/litellm
# WebUI DB URL (used by 'wolinex' service)
WEBUI_DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PG_PASSWORD@postgres:5432/webui

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
LITELLM_DISABLE_NO_REDIS_WARNING=true

# ── LiteLLM Gateway (lango) ───────────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-wolinet-CHANGE_ME_MASTER_KEY
WOLINET_GATEWAY_MASTER_KEY=sk-wolinet-CHANGE_ME_MASTER_KEY
LITELLM_SALT_KEY=sk-wolinet-CHANGE_ME_MASTER_KEY
STORE_MODEL_IN_DB=true
DATABASE_CONNECTION_POOL_LIMIT=20
DEFAULT_MODEL=wolinex-coder
DEFAULT_MODELS=wolinex-coder
WOLINET_IMAGE_TAG=latest
GITHUB_REPOSITORY_OWNER=wolinet-renatus

# Nginx Basic Auth for the public Xinference administration hostname
MITAMBO_ADMIN_USER=operator
MITAMBO_ADMIN_PASSWORD=CHANGE_ME_UNIQUE_LONG_PASSWORD

# ── Open WebUI (wolinex) ──────────────────────────────────────────────────────
WEBUI_SECRET_KEY=CHANGE_ME_WEBUI_SECRET_256BIT_RANDOM
WEBUI_NAME=Wolinet AI
WEBUI_URL=https://wolinex.wolinet.com
# LiteLLM integration (internal bridge)
LITELLM_BASE_URL=http://lango:4000
OPENAI_API_BASE_URL=http://lango:4000/v1
OPENAI_API_KEY=sk-wolinet-CHANGE_ME_MASTER_KEY
# DB Pool
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ENABLE_SESSION_SHARING=true
WEBUI_AUTH_COOKIE_SAME_SITE=lax
WEBUI_AUTH_COOKIE_SECURE=True
WEBUI_SESSION_COOKIE_SAME_SITE=lax
WEBUI_SESSION_COOKIE_SECURE=True
WEBUI_AUTH_COOKIE_DOMAIN=.wolinet.com
WOLINET_COOKIE_DOMAIN=.wolinet.com
# Budget
DEFAULT_USER_BUDGET=25.0

# ── Xinference Engine (mitambo) ───────────────────────────────────────────────
WOLINET_API_BASE=http://mitambo:9997/v1
WOLINET_INFERENCE_URL=http://mitambo:9997
WOLINET_API_KEY=not-needed
XINFERENCE_API_KEY=CHANGE_ME_AFTER_INITIAL_XINFERENCE_SETUP
XINFERENCE_IMAGE_TAG=latest
XINFERENCE_MODEL_SRC=huggingface
XINFERENCE_CPU_IMAGE=xprobe/xinference:v3.0.0-cpu
XINFERENCE_GPU_IMAGE=xprobe/xinference:v3.0.0
HF_TOKEN=

# TLS certificate provisioning
CERTBOT_EMAIL=devops@wolinet.com

# ── Cloud API Keys (Tier 2 / 3 fallback) ─────────────────────────────────────
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
