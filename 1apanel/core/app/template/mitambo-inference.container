[Container]
ContainerName=wolinet-mitambo
Pod=wolinetai-core-pod
Image=ghcr.io/wolinet-renatus/wolinet-mitambo-cpu:latest
Volume=/var/lib/wolinet/models:/models:ro
Volume=/var/lib/wolinet/data/mitambo:/root/.xinference:Z
ShmSize=8g
Environment=XINFERENCE_HOME=/root/.xinference
Environment=XINFERENCE_AUTH_DB_PATH=/root/.xinference/auth/auth.db
Environment=XINFERENCE_MODEL_SRC=huggingface
Environment=XINFERENCE_ENABLE_VIRTUAL_ENV=0
Environment=XINFERENCE_AUTH_ADVANCED=true
Environment=XINFERENCE_ADMIN_USER=admin
Environment=XINFERENCE_ADMIN_PASSWORD=Woli@1211
Environment=XINFERENCE_API_KEY=sk-XvKFiwDoOtOe8i4lwbzb8Q
Environment=OMP_NUM_THREADS=8
Environment=VECLIB_MAXIMUM_THREADS=8
Exec=xinference-local -H 0.0.0.0 -p 9997 --log-level info

[Service]
Restart=always

[Install]
WantedBy=default.target
