FROM ubuntu:24.04 AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG RUSTUP_VERSION=1.28.2
ARG RUSTUP_SHA256=20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c
ARG RUST_TOOLCHAIN=1.99.0
ARG WOLINEX_CLI_VERSION=1.58.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    dpkg-dev \
    git \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    CARGO_NET_RETRY=10 \
    CARGO_HTTP_MULTIPLEXING=false \
    CARGO_BUILD_JOBS=6 \
    CARGO_PROFILE_RELEASE_LTO=off \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16 \
    PATH=/usr/local/cargo/bin:${PATH}

RUN curl -fsSL -o /tmp/rustup-init \
      "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init" \
    && echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" \
    && rm -f /tmp/rustup-init

WORKDIR /workspace/WolinexIde
COPY WolinexIde/ .

RUN cargo build --release --locked --no-default-features --features portable-default -p goose-cli --bin goose \
    && (strip target/release/goose || true) \
    && mkdir -p /pkg/DEBIAN /pkg/usr/bin /pkg/etc/wolinet /out \
    && install -m 0755 target/release/goose /pkg/usr/bin/wolinex \
    && ln -sf /usr/bin/wolinex /pkg/usr/bin/wolinex-cli \
    && printf 'Package: wolinex-cli\nVersion: %s-1\nSection: devel\nPriority: optional\nArchitecture: amd64\nInstalled-Size: %s\nDepends: ca-certificates\nMaintainer: Wolinet AI <engineering@wolinet.com>\nDescription: Wolinex Autonomous Agent CLI\n Native Rust Wolinex CLI powered by the Goose agent runtime.\n' "${WOLINEX_CLI_VERSION}" "$(du -sk /pkg/usr | awk '{print $1}')" > /pkg/DEBIAN/control \
    && dpkg-deb --root-owner-group --build /pkg /out/wolinex-cli_amd64.deb \
    && rm -rf /workspace/WolinexIde/target /pkg
