# Wolinet Wolinex Web Portal Configuration
# Installed to /etc/wolinet/wolinex-web.env (Linux) or ~/.local/etc/wolinex-web/env (macOS)

HOST=0.0.0.0
PORT=8081
DATA_DIR=/var/lib/wolinet/wolinex

# Lango Gateway integration
LITELLM_BASE_URL=http://127.0.0.1:4000
OPENAI_API_BASE_URL=http://127.0.0.1:4000/v1
OPENAI_API_BASE_URLS=http://127.0.0.1:4000/v1
# OPENAI_API_KEY=sk-replace-with-gateway-key
# LITELLM_MASTER_KEY=sk-replace-with-gateway-master-key

# Shared PostgreSQL session/user storage (optional; omit to use local SQLite under DATA_DIR)
# DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/webui

# Cryptographic session signing key (auto-generated on install)
# WEBUI_SECRET_KEY=replace-with-random-secret

WEBUI_NAME="Wolinet AI"
ENABLE_OPENAI_API=True
ENABLE_OLLAMA_API=False
ENABLE_FORWARD_USER_INFO_HEADERS=True
BYPASS_WEB_SEARCH_EMBEDDING_AND_RETRIEVAL=True
USE_SLIM_DOCKER=true
VECTOR_DB=pgvector
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
