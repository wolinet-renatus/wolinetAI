# Wolinet Stage 1 DEC Orchestrator (1apanel) Configuration
# Native SQLite state ONLY (never mixes configuration with PostgreSQL)

PANEL_BASE_DIR=/var/lib/wolinet/data
BASE_DIR=/var/lib/wolinet/data/1panel
ORIGINAL_PORT=8888
ORIGINAL_VERSION=v2.0.0
ORIGINAL_USERNAME=admin
# ORIGINAL_PASSWORD=replace-with-strong-password
LANGUAGE=en

# Stage 1 Backing Data Cluster Ports (Rootless Podman)
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_DB=litellm
# POSTGRES_PASSWORD=replace-with-strong-postgres-password
REDIS_PORT=6379
