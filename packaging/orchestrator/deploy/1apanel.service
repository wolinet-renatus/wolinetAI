[Unit]
Description=Wolinet Stage 1 DEC 1Panel Control Plane (Isolated Native SQLite)
Documentation=https://wolinet.ai/docs
After=network-online.target podman.socket 1panel-agent.service
Wants=network-online.target podman.socket 1panel-agent.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/wolinet/1apanel.env
Environment=PANEL_BASE_DIR=/var/lib/wolinet/data
Environment=BASE_DIR=/var/lib/wolinet/data/1panel
Environment=ORIGINAL_PORT=8888
Environment=ORIGINAL_VERSION=v2.0.0
Environment=LANGUAGE=en
ExecStartPre=/usr/bin/install -d -m 0755 -o root -g root /var/lib/wolinet/data/1panel/db
ExecStart=/usr/bin/wolinet-orchestrator serve-core
Restart=always
RestartSec=5s
LimitNOFILE=65535
LimitNPROC=65535
TasksMax=infinity
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SYS_ADMIN CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
