#!/usr/bin/env bash
# Wolinet Stage 1 DEC Orchestrator CLI (1apanel + 1panel-agent + Podman backing datastores)
set -euo pipefail

resolve_real_path() {
  readlink -f "$1" 2>/dev/null \
    || python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$1" 2>/dev/null \
    || printf '%s\n' "$1"
}

SELF_PATH="$(resolve_real_path "${BASH_SOURCE[0]}")"
ORCH_HOME="$(cd "$(dirname "${SELF_PATH}")/.." && pwd)"
CORE_BIN="${ORCH_HOME}/bin/1apanel"
AGENT_BIN="${ORCH_HOME}/bin/1panel-agent"

DEFAULT_ENV="/etc/wolinet/1apanel.env"
if [[ -f "${ORCH_HOME}/etc/1apanel.env" ]]; then
  DEFAULT_ENV="${ORCH_HOME}/etc/1apanel.env"
fi
ENV_FILE="${WOLINET_ORCH_ENV_FILE:-${DEFAULT_ENV}}"

load_env() {
  if [[ -f "${ENV_FILE}" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "${ENV_FILE}"
    set +a
  fi
  export PANEL_BASE_DIR="${PANEL_BASE_DIR:-/var/lib/wolinet/data}"
  export BASE_DIR="${BASE_DIR:-${PANEL_BASE_DIR}/1panel}"
  export ORIGINAL_PORT="${ORIGINAL_PORT:-8888}"
  export ORIGINAL_VERSION="${ORIGINAL_VERSION:-v2.0.0}"
  export LANGUAGE="${LANGUAGE:-en}"
  export POSTGRES_PORT="${POSTGRES_PORT:-5433}"
  export REDIS_PORT="${REDIS_PORT:-6379}"
  if [[ -z "${CONTAINER_HOST:-}" ]]; then
    if [[ -S "/run/podman/podman.sock" ]]; then
      export CONTAINER_HOST="unix:///run/podman/podman.sock"
    elif [[ -S "/run/user/$(id -u)/podman/podman.sock" ]]; then
      export CONTAINER_HOST="unix:///run/user/$(id -u)/podman/podman.sock"
    fi
  fi
  if [[ -n "${CONTAINER_HOST:-}" ]]; then
    export DOCKER_HOST="${DOCKER_HOST:-${CONTAINER_HOST}}"
  fi
}

datastore_up() {
  load_env
  command -v podman >/dev/null 2>&1 || { echo "podman is required for Stage 1 backing datastores" >&2; exit 1; }

  local pg_data="${PANEL_BASE_DIR}/postgres"
  local redis_data="${PANEL_BASE_DIR}/redis"
  local init_script="${ORCH_HOME}/scripts/init-postgres.sh"
  mkdir -p "${pg_data}" "${redis_data}"

  if ! podman pod exists wolinetai-core-pod >/dev/null 2>&1; then
    podman pod create \
      --name wolinetai-core-pod \
      -p 127.0.0.1:${POSTGRES_PORT}:5432 \
      -p 127.0.0.1:${REDIS_PORT}:6379
  fi

  if ! podman container exists wolinetai-postgres-1 >/dev/null 2>&1; then
    local pg_args=(
      --pod wolinetai-core-pod
      --name wolinetai-postgres-1
      --restart always
      -e "POSTGRES_USER=${POSTGRES_USER:-postgres}"
      -e "POSTGRES_PASSWORD=${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD in ${ENV_FILE}}"
      -e "POSTGRES_DB=${POSTGRES_DB:-litellm}"
      -e "PGDATA=/var/lib/postgresql/data/pgdata"
      -v "${pg_data}:/var/lib/postgresql/data"
    )
    [[ -n "${PG_MEM_MB:-}" ]] && pg_args+=(--memory "${PG_MEM_MB}m")
    [[ -n "${PG_SHM_MB:-}" ]] && pg_args+=(--shm-size "${PG_SHM_MB}m")
    [[ -f "${init_script}" ]] && pg_args+=(-v "${init_script}:/docker-entrypoint-initdb.d/00-init.sh:ro")
    local pg_cmd=(postgres -c tcp_keepalives_idle=60 -c tcp_keepalives_interval=10 -c tcp_keepalives_count=5)
    [[ -n "${PG_SHARED_BUFFERS_MB:-}" ]] && pg_cmd+=(-c "shared_buffers=${PG_SHARED_BUFFERS_MB}MB")
    podman run -d "${pg_args[@]}" docker.io/pgvector/pgvector:pg16 \
      "${pg_cmd[@]}" >/dev/null
  else
    podman start wolinetai-postgres-1 >/dev/null
  fi

  if ! podman container exists wolinetai-redis-1 >/dev/null 2>&1; then
    local redis_args=(
      --pod wolinetai-core-pod
      --name wolinetai-redis-1
      --restart always
      -v "${redis_data}:/data"
    )
    [[ -n "${REDIS_MEM_MB:-}" ]] && redis_args+=(--memory "${REDIS_MEM_MB}m")
    local redis_cmd=(redis-server --appendonly yes)
    if [[ -n "${REDIS_MAXMEM_MB:-}" ]]; then
      redis_cmd+=(--maxmemory "${REDIS_MAXMEM_MB}mb" --maxmemory-policy allkeys-lru)
    fi
    podman run -d "${redis_args[@]}" docker.io/library/redis:7-alpine \
      "${redis_cmd[@]}" >/dev/null
  else
    podman start wolinetai-redis-1 >/dev/null
  fi

  echo "Stage 1 backing datastores up: PostgreSQL 127.0.0.1:${POSTGRES_PORT}, Redis 127.0.0.1:${REDIS_PORT}"
}

doctor_cmd() {
  load_env
  echo "ORCH_HOME=${ORCH_HOME}"
  echo "CORE_BIN=${CORE_BIN} ($([[ -x "${CORE_BIN}" ]] && echo present || echo missing))"
  echo "AGENT_BIN=${AGENT_BIN} ($([[ -x "${AGENT_BIN}" ]] && echo present || echo missing))"
  echo "SQLITE_DB_DIR=${BASE_DIR}/db"
  echo "CONTROL_PLANE_PORT=${ORIGINAL_PORT}"
  echo "CONTAINER_HOST=${CONTAINER_HOST:-unset}"
  command -v podman >/dev/null 2>&1 && echo "podman=$(podman --version)" || echo "podman=missing"
}

case "${1:-help}" in
  serve-core)
    load_env
    mkdir -p "${BASE_DIR}/db"
    exec "${CORE_BIN}"
    ;;
  serve-agent)
    load_env
    mkdir -p "${BASE_DIR}/db"
    exec "${AGENT_BIN}"
    ;;
  datastore-up)
    datastore_up
    ;;
  migrate-seed)
    load_env
    shift || true
    exec "${ORCH_HOME}/bin/wolinet-migrate-seed" "$@"
    ;;
  start)
    if [[ "$(uname -s)" == "Linux" ]] && command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
      systemctl start 1panel-agent.service 1apanel.service
      exit 0
    fi
    if [[ "$(uname -s)" == "Darwin" ]]; then
      launchctl kickstart -k "gui/$(id -u)/com.wolinet.1panel-agent" >/dev/null 2>&1 || true
      launchctl kickstart -k "gui/$(id -u)/com.wolinet.1apanel" >/dev/null 2>&1 || true
      exit 0
    fi
    load_env
    mkdir -p "${BASE_DIR}/db"
    exec "${CORE_BIN}"
    ;;
  stop)
    if [[ "$(uname -s)" == "Linux" ]] && command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
      systemctl stop 1apanel.service 1panel-agent.service
      exit 0
    fi
    if [[ "$(uname -s)" == "Darwin" ]]; then
      launchctl bootout "gui/$(id -u)/com.wolinet.1apanel" >/dev/null 2>&1 || true
      launchctl bootout "gui/$(id -u)/com.wolinet.1panel-agent" >/dev/null 2>&1 || true
      exit 0
    fi
    pkill -f "${CORE_BIN}" || true
    pkill -f "${AGENT_BIN}" || true
    ;;
  status)
    if [[ "$(uname -s)" == "Linux" ]] && command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
      systemctl status 1panel-agent.service 1apanel.service --no-pager
    else
      load_env
      curl -fsS "http://127.0.0.1:${ORIGINAL_PORT}/" >/dev/null && echo "1apanel listening on :${ORIGINAL_PORT}"
    fi
    ;;
  doctor)
    doctor_cmd
    ;;
  version|--version|-V)
    "${CORE_BIN}" version 2>/dev/null || echo "wolinet-orchestrator 2.0.0"
    ;;
  help|--help|-h)
    cat <<'EOF'
Wolinet Stage 1 DEC Orchestrator (1apanel)

Usage: wolinet-orchestrator <command>
  serve-core    Run 1apanel control plane in foreground
  serve-agent   Run 1panel-agent daemon in foreground
  datastore-up  Provision Stage 1 Postgres 16 (:5433->5432) & Redis 7 (:6379) via Podman
  migrate-seed  Run idempotent Postgres, Mitambo SQLite & 1Panel SQLite migrations/seeding
  start         Start Stage 1 services (systemd / launchd)
  stop          Stop Stage 1 services
  status        Show Stage 1 service status
  doctor        Check binaries, isolated SQLite DB path, ports, and Podman runtime
  version       Print orchestrator version
EOF
    ;;
  *)
    load_env
    exec "${CORE_BIN}" "$@"
    ;;
esac
