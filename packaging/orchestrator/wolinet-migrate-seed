# Seed Agentic Skills into LiteLLM_ClaudeCodePluginTable
skills_list = []
if skills_seed_path and skills_seed_path.exists():
    try:
        loaded = json.loads(skills_seed_path.read_text(encoding="utf-8"))
        if isinstance(loaded, list):
