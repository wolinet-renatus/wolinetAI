    DELETE FROM model WHERE LOWER(id) LIKE '%tiny-llama%' OR LOWER(id) LIKE '%tinyllama%';
  END IF;
END $$;
EOSQL
    if [[ "${db_name}" == "${WEBUI_DB}" ]]; then
      run_psql_cmd "${db_name}" <<'EOSQL' >/dev/null 2>&1 || true
DO $$
BEGIN
  IF EXISTS (SELECT FROM pg_tables WHERE schemaname = 'public' AND tablename = 'alembic_version')
