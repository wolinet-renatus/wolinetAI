    webui_state="$(run_psql_cmd "${WEBUI_DB}" -tAc "
      SELECT CASE
        WHEN to_regclass('public.oauth_session') IS NOT NULL
         AND NOT EXISTS (
           SELECT 1 FROM information_schema.columns
           WHERE table_schema = 'public' AND table_name = 'oauth_session' AND column_name = 'user_id'
         )
         AND COALESCE((SELECT count(*) FROM \"user\"), 0) = 0
        THEN 'reset' ELSE 'ok' END;
