        {"tier": "agentic_skills", "standards": ["Agent Skills 1.0", "Claude Code Marketplace"]},
    ),
]
for m_key, m_val, m_meta in memories:
    mid = f"mem-{hashlib.sha1(m_key.encode('utf-8')).hexdigest()[:12]}"
    stmts.append(f"""
INSERT INTO "LiteLLM_MemoryTable" (
  memory_id, key, value, metadata, user_id, created_by, updated_by, created_at, updated_at
) VALUES (
