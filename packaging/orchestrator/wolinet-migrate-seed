for sk in skills_list:
    sname = str(sk.get("name") or "").strip()
    if not sname:
        continue
    sid = str(uuid.uuid5(uuid.NAMESPACE_DNS, f"wolinet.skill.{sname}"))
    sver = str(sk.get("version") or "1.0.0")
    sdesc = str(sk.get("description") or f"Wolinet skill {sname}")
    manifest_str = json.dumps(sk)
    stmts.append(f"""
INSERT INTO "LiteLLM_ClaudeCodePluginTable" (
  id, name, version, description, manifest_json, files_json, enabled, created_by, created_at, updated_at
