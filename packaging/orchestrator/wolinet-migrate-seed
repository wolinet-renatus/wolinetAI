        ('web.loader.engine', '"obscura"'::json, EXTRACT(EPOCH FROM NOW())::bigint),
        ('web.search.bypass_embedding_and_retrieval', 'true'::json, EXTRACT(EPOCH FROM NOW())::bigint),
        ('memories.enable', 'true'::json, EXTRACT(EPOCH FROM NOW())::bigint),
        ('memories.system_context.enable', 'true'::json, EXTRACT(EPOCH FROM NOW())::bigint)
      ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value, updated_at = EXCLUDED.updated_at;
    END IF;
  END IF;
END $$;
EOSQL
  fi
}

seed_mitambo_local_state() {
  local mitambo_data="${XINFERENCE_HOME:-/var/lib/wolinet/data/mitambo}"
  local models_dir="${MITAMBO_MODELS_DIR:-/var/lib/wolinet/models}"
  mkdir -p "${mitambo_data}/auth" "${mitambo_data}/model/v2" "${models_dir}"

  local reg_dir=""
  for cand in "/opt/wolinet/mitambo/models/registrations" "${ORCH_HOME}/models/registrations"; do
    [[ -d "${cand}" ]] && reg_dir="${cand}" && break
  done

  if [[ -n "${reg_dir}" ]]; then
    echo "[migrate-seed] Seeding Mitambo model registrations from ${reg_dir}..."
    "${PY_BIN}" - "${reg_dir}" "${mitambo_data}/model/v2" <<'PY'
import json, pathlib, shutil, sys
src_dir, dst_root = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
for fp in sorted(src_dir.glob("*.json")):
    try:
        data = json.loads(fp.read_text(encoding="utf-8"))
    except Exception:
        continue
    name = data.get("model_name")
    if not name:
        continue
    abilities = data.get("model_ability", [])
    family = data.get("model_family", "")
    if any(a in abilities for a in ("text2image", "image2image", "inpainting", "ocr", "docanalyze")) or family == "ocr":
        mtype = "image"
    elif any(a in abilities for a in ("audio2text", "text2audio", "speech2text")) or family == "whisper":
        mtype = "audio"
    elif "dimensions" in data:
        mtype = "embedding"
    elif "rerank" in name:
        mtype = "rerank"
    else:
        mtype = "llm"
    out = dst_root / mtype
    out.mkdir(parents=True, exist_ok=True)
    shutil.copy2(fp, out / f"{name}.json")
PY
  fi

  # Initialize isolated Mitambo SQLite pools
  "${PY_BIN}" - "${mitambo_data}" "${XINFERENCE_ADMIN_USER:-admin}" "${XINFERENCE_ADMIN_PASSWORD:-}" "${XINFERENCE_API_KEY:-}" <<'PY'
import hashlib, pathlib, sqlite3, sys

base = pathlib.Path(sys.argv[1])
admin_user, admin_pw, api_key = sys.argv[2], sys.argv[3], sys.argv[4]

for db_name in ("launch_history.db", "token_routers.db", "download_tasks.db"):
    conn = sqlite3.connect(base / db_name)
    conn.execute("CREATE TABLE IF NOT EXISTS _wolinet_meta (key TEXT PRIMARY KEY, value TEXT)")
    conn.execute("INSERT OR REPLACE INTO _wolinet_meta (key, value) VALUES ('initialized', 'true')")
    conn.commit()
    conn.close()

auth_db = base / "auth" / "auth.db"
conn = sqlite3.connect(auth_db)
conn.executescript("""
CREATE TABLE IF NOT EXISTS users (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  username TEXT NOT NULL,
  password_hash TEXT,
  source TEXT NOT NULL DEFAULT 'local',
  oidc_sub TEXT,
  enabled INTEGER NOT NULL DEFAULT 1,
  must_change_password INTEGER NOT NULL DEFAULT 0,
  token_version INTEGER NOT NULL DEFAULT 0,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
CREATE UNIQUE INDEX IF NOT EXISTS idx_users_source_username ON users(source, username);
CREATE TABLE IF NOT EXISTS user_permissions (
  user_id INTEGER NOT NULL,
  permission TEXT NOT NULL,
  PRIMARY KEY (user_id, permission),
  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);
CREATE TABLE IF NOT EXISTS api_keys (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  user_id INTEGER NOT NULL,
  key_hash TEXT UNIQUE NOT NULL,
  key_encrypted TEXT NOT NULL DEFAULT '',
  key_prefix TEXT NOT NULL DEFAULT '',
  name TEXT NOT NULL DEFAULT '',
  description TEXT,
  enabled INTEGER NOT NULL DEFAULT 1,
  expires_at TIMESTAMP,
  encryption_version INTEGER DEFAULT 1,
  rate_limit_max_failures INTEGER,
  rate_limit_window_seconds INTEGER,
  rate_limit_ban_seconds INTEGER,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);
CREATE TABLE IF NOT EXISTS api_key_model_permissions (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  api_key_id INTEGER NOT NULL,
  permission_type TEXT NOT NULL DEFAULT 'all',
  permission_value TEXT,
  UNIQUE(api_key_id, permission_type, permission_value),
  FOREIGN KEY (api_key_id) REFERENCES api_keys(id) ON DELETE CASCADE
);
CREATE TABLE IF NOT EXISTS refresh_tokens (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  user_id INTEGER NOT NULL,
  token_hash TEXT UNIQUE NOT NULL,
  expires_at TIMESTAMP NOT NULL,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);
CREATE TABLE IF NOT EXISTS system_config (
  key TEXT PRIMARY KEY,
  value TEXT NOT NULL
);
""")

existing_user_cols = {r[1] for r in conn.execute("PRAGMA table_info(users)").fetchall()}
if "oidc_sub" not in existing_user_cols:
    conn.execute("ALTER TABLE users ADD COLUMN oidc_sub TEXT")
if "token_version" not in existing_user_cols:
    conn.execute("ALTER TABLE users ADD COLUMN token_version INTEGER NOT NULL DEFAULT 0")
existing_key_cols = {r[1] for r in conn.execute("PRAGMA table_info(api_keys)").fetchall()}
if "description" not in existing_key_cols:
    conn.execute("ALTER TABLE api_keys ADD COLUMN description TEXT")

INITIAL_ADMIN_PERMISSIONS = [
    "admin",
    "models:list",
    "models:read",
    "models:write",
    "models:register",
    "keys:create",
    "keys:manage",
    "users:manage",
    "cache:list",
    "cache:delete",
    "virtualenv:list",
    "virtualenv:delete",
    "logs:list",
    "model_requests:read_body",
    "monitor:view",
    "settings:read",
    "settings:write",
    "routers:list",
    "routers:read",
    "routers:write",
    "routers:operate",
]

if admin_pw and not admin_pw.startswith("replace-"):
    try:
        import bcrypt
        pw_hash = bcrypt.hashpw(admin_pw.encode("utf-8")[:72], bcrypt.gensalt()).decode("utf-8")
    except Exception:
        pw_hash = hashlib.sha256(admin_pw.encode("utf-8")).hexdigest()
    existing_admin = conn.execute(
        "SELECT id FROM users WHERE username=? AND source='local'", (admin_user,)
    ).fetchone()
    if existing_admin:
        uid = existing_admin[0]
        conn.execute(
            "UPDATE users SET password_hash=?, enabled=1, must_change_password=0 WHERE id=?",
            (pw_hash, uid),
        )
    else:
        cur = conn.execute(
            "INSERT INTO users (username, password_hash, source, enabled, must_change_password) "
            "VALUES (?, ?, 'local', 1, 0)",
            (admin_user, pw_hash),
        )
        uid = cur.lastrowid
    for perm in INITIAL_ADMIN_PERMISSIONS:
        conn.execute(
            "INSERT OR IGNORE INTO user_permissions (user_id, permission) VALUES (?, ?)",
            (uid, perm),
        )
    conn.commit()

if api_key and not api_key.startswith("replace-"):
    row = conn.execute("SELECT id FROM users WHERE username=? AND source='local'", (admin_user,)).fetchone()
    if row:
        uid = row[0]
        khash = hashlib.sha256(api_key.encode("utf-8")).hexdigest()
        existing = conn.execute("SELECT id FROM api_keys WHERE key_hash=?", (khash,)).fetchone()
        if not existing:
            cur = conn.execute(
                "INSERT INTO api_keys (user_id, key_hash, key_encrypted, key_prefix, name, enabled) VALUES (?, ?, '', ?, 'lango-gateway', 1)",
                (uid, khash, api_key[:7]),
            )
            conn.execute(
                "INSERT OR IGNORE INTO api_key_model_permissions (api_key_id, permission_type, permission_value) VALUES (?, 'all', NULL)",
                (cur.lastrowid,),
            )
            conn.commit()
conn.close()
PY

  if id -u mitambo >/dev/null 2>&1; then
    chown -R mitambo:mitambo "${mitambo_data}" "${models_dir}"
  fi
}

