    if [[ "${webui_state}" == "reset" ]]; then
      echo "[migrate-seed] Resetting stale static 02_webui_core.sql schema on empty '${WEBUI_DB}' so Alembic initializes cleanly..."
      run_psql_cmd "${WEBUI_DB}" -v ON_ERROR_STOP=1 <<'EOSQL' >/dev/null
