       SELECT 1 FROM information_schema.columns
       WHERE table_schema = 'public' AND table_name = 'config' AND column_name = 'key'
     ) THEN
    UPDATE alembic_version SET version_num = '3c9b0ca343fd'
    WHERE version_num IN ('d4c1a8e37b62', 'f2a4b6c8d0e1');
  END IF;
END $$;
EOSQL
    fi
  done

  # Run bundled WebUI Alembic upgrade head + SQLAlchemy metadata create_all single-process before workers boot
  if [[ "${has_webui_runtime}" == "1" ]]; then
    echo "[migrate-seed] Running Wolinex Web Alembic upgrade head..."
    (
      cd /opt/wolinet/wolinex-web/backend/open_webui
      local web_admin_email="${WEBUI_ADMIN_EMAIL:-admin@wolinet.com}"
      local web_admin_pass="${WEBUI_ADMIN_PASSWORD:-${ORIGINAL_PASSWORD:-}}"
      local web_data_dir="${DATA_DIR:-/var/lib/wolinet/wolinex}"
      mkdir -p "${web_data_dir}/static"
      PYTHONPATH="/opt/wolinet/wolinex-web/backend" \
