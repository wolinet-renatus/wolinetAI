    if not admin_pass or admin_pass.startswith("replace-"):
        return
    hashed = bcrypt.hashpw(admin_pass.encode("utf-8")[:72], bcrypt.gensalt()).decode("utf-8")
    existing = await Users.get_user_by_email(admin_email)
    if not existing:
        await Auths.insert_new_auth(
            email=admin_email,
            password=hashed,
            name="Admin",
            role="admin",
