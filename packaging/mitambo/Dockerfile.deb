FROM ubuntu:24.04 AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG PYTHON_VERSION=3.12
ARG UV_VERSION=0.12.19
ARG MITAMBO_VERSION=4.2.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    dpkg-dev \
    libgomp1 \
    libglib2.0-0 \
    libgl1 \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --break-system-packages "uv==${UV_VERSION}"

ENV UV_PYTHON_INSTALL_DIR=/opt/wolinet/mitambo/python \
    UV_HTTP_TIMEOUT=300 \
    NO_WEB_UI=1 \
    XINFERENCE_SKIP_MODEL_SPEC_VALIDATION=1 \
    SETUPTOOLS_SCM_PRETEND_VERSION="${MITAMBO_VERSION}" \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_WOLINET_INFERENCE="${MITAMBO_VERSION}"

RUN uv python install "${PYTHON_VERSION}" \
    && PY_BIN="$(find /opt/wolinet/mitambo/python -path '*/bin/python3' | head -n1)" \
    && uv venv /opt/wolinet/mitambo/venv --python "${PY_BIN}"

COPY inference /src/inference

RUN . /opt/wolinet/mitambo/venv/bin/activate \
    && uv pip install --python /opt/wolinet/mitambo/venv/bin/python \
         --index-url https://download.pytorch.org/whl/cpu \
         torch torchvision \
    && uv pip install --python /opt/wolinet/mitambo/venv/bin/python \
         "xoscar>=0.10.0" \
         "psutil>=5.9.0" \
         "pillow" \
         "click<8.2.0" \
         "tqdm>=4.27" \
         "tabulate" \
         "requests" \
         "aiohttp" \
         "pydantic>2" \
         "anyio" \
         "fastapi>=0.110.3,<0.137" \
         "python-multipart>=0.0.18" \
         "orjson" \
         "uvicorn" \
         "PyYAML" \
         "huggingface-hub>=0.19.4" \
         "filelock>=3.30.0" \
         "typing_extensions" \
         "modelscope>=1.21.0" \
         "sse_starlette>=1.6.5" \
         "openai>=1.40.0" \
         "anthropic>=0.25.0" \
         "python-jose[cryptography]" \
         "bcrypt>=4.0.0" \
         "aioprometheus[starlette]>=23.12.0" \
         "httpx" \
         "nvidia-ml-py" \
         "async-timeout" \
         "setproctitle" \
         "transformers" \
         "peft>=0.18.0" \
         "timm" \
         "packaging>=24.2" \
         "setuptools>=77,<82" \
         "setuptools-scm>=8" \
         "wheel" \
         "gguf" \
         "xllamacpp>=0.2.0" \
    && uv pip install --python /opt/wolinet/mitambo/venv/bin/python --no-build-isolation --no-deps /src/inference \
    && find /opt/wolinet/mitambo -type d -name '__pycache__' -prune -exec rm -rf {} + \
    && find /opt/wolinet/mitambo -type d -name 'tests' -prune -exec rm -rf {} +

COPY packaging/mitambo /src/packaging

RUN mkdir -p \
      /pkg/DEBIAN \
      /pkg/opt/wolinet/mitambo/bin \
      /pkg/opt/wolinet/mitambo/models/registrations \
      /pkg/usr/bin \
      /pkg/lib/systemd/system \
      /pkg/etc/wolinet \
      /pkg/etc/security/limits.d \
      /out \
    && mv /opt/wolinet/mitambo/python /pkg/opt/wolinet/mitambo/python \
    && mv /opt/wolinet/mitambo/venv /pkg/opt/wolinet/mitambo/venv \
    && cp /src/packaging/mitambo /pkg/opt/wolinet/mitambo/bin/mitambo \
    && chmod 0755 /pkg/opt/wolinet/mitambo/bin/mitambo \
    && ln -sf /opt/wolinet/mitambo/bin/mitambo /pkg/usr/bin/mitambo \
    && if [ -d /src/inference/models/registrations ]; then \
         cp -r /src/inference/models/registrations/. /pkg/opt/wolinet/mitambo/models/registrations/; \
       fi \
    && if [ -d /src/inference/frontend/out ]; then \
         cp -r /src/inference/frontend/out /pkg/opt/wolinet/mitambo/frontend; \
       fi \
    && cp /src/packaging/deploy/mitambo.service /pkg/lib/systemd/system/mitambo.service \
    && cp /src/packaging/deploy/env.example /pkg/etc/wolinet/mitambo.env.example \
    && chmod 0640 /pkg/etc/wolinet/mitambo.env.example \
    && printf '* soft memlock unlimited\n* hard memlock unlimited\n* soft nofile 65535\n* hard nofile 65535\n' > /pkg/etc/security/limits.d/99-wolinet-mitambo.conf \
    && cp /src/packaging/deploy/debian/postinst /pkg/DEBIAN/postinst \
    && cp /src/packaging/deploy/debian/prerm /pkg/DEBIAN/prerm \
    && chmod 0755 /pkg/DEBIAN/postinst /pkg/DEBIAN/prerm \
    && INSTALLED_KB="$(du -sk /pkg/opt | awk '{print $1}')" \
    && printf 'Package: mitambo-inference\nVersion: %s-1\nSection: science\nPriority: optional\nArchitecture: amd64\nInstalled-Size: %s\nDepends: ca-certificates, libgomp1, libglib2.0-0\nMaintainer: Wolinet AI <engineering@wolinet.com>\nDescription: Wolinet Mitambo Sovereign Inference Engine (self-contained runtime)\n Bundled Python 3.12 + Xinference + llama.cpp CPU runtime and systemd unit.\n' "${MITAMBO_VERSION}" "${INSTALLED_KB}" > /pkg/DEBIAN/control \
    && printf '/etc/wolinet/mitambo.env.example\n' > /pkg/DEBIAN/conffiles \
    && dpkg-deb --root-owner-group --build /pkg /out/mitambo-inference_amd64.deb
