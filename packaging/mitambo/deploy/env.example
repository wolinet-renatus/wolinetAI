# Wolinet Mitambo Inference Engine Configuration
# Installed to /etc/wolinet/mitambo.env (Linux) or ~/.local/etc/mitambo/env (macOS)

MITAMBO_HOST=127.0.0.1
MITAMBO_PORT=9997
XINFERENCE_HOME=/var/lib/wolinet/mitambo
MITAMBO_MODELS_DIR=/var/lib/wolinet/models
XINFERENCE_MODEL_SRC=huggingface
XINFERENCE_AUTH_ADVANCED=true
XINFERENCE_HTTP_REQUEST_TIMEOUT=600

# Optional authentication and gateway key integration (set during install or manually)
# XINFERENCE_ADMIN_USER=admin
# XINFERENCE_ADMIN_PASSWORD=replace-with-strong-password
# XINFERENCE_API_KEY=replace-with-api-key
