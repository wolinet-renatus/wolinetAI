{
  "version": "1.0.0",
  "organization": "Wolinet AI",
  "products": [
    {
      "id": "lango",
      "name": "Wolinet Lango Gateway",
      "category": "server_core",
      "deployable_to_server": true,
      "path": "gateway",
      "sub_branch": "stack/lango",
      "description": "Sovereign API Gateway, proxy router, MCP host, Obscura adapter, rate limiting, and auth",
      "ports": [4000],
      "healthcheck": "http://localhost:4000/health/liveliness",
      "build": {
        "type": "rust_binary",
        "command": "packaging/lango/build.sh",
        "image": "wolinet-lango:latest",
        "context": "gateway",
        "dockerfile": "gateway/litellm-rust/Dockerfile.deb"
      },
      "installer": {
        "role": "server",
        "boot_stage": 3,
        "builder": "packaging/lango/build.sh",
        "script": "scripts/install-lango.sh",
        "artifacts_dir": "dist/installers/server/lango"
      }
    },
    {
      "id": "mitambo",
      "name": "Wolinet Mitambo Inference",
      "category": "server_core",
      "deployable_to_server": true,
      "path": "inference",
      "sub_branch": "stack/mitambo",
      "description": "Sovereign local model inference engine with Apple Silicon MPS & NVIDIA CUDA acceleration",
      "ports": [9997],
      "healthcheck": "http://localhost:9997/v1/models",
      "build": {
        "type": "binary_service",
        "command": "packaging/mitambo/build.sh",
        "script": "inference/start-mitambo.sh",
        "image": "wolinet-mitambo:latest"
      },
      "installer": {
        "role": "server",
        "boot_stage": 2,
        "builder": "packaging/mitambo/build.sh",
        "script": "scripts/install-mitambo.sh",
        "artifacts_dir": "dist/installers/server/mitambo"
      }
    },
    {
      "id": "web-client",
      "name": "Wolinet Web Client & Chat (Wolinex WebUI)",
      "category": "web_app",
      "deployable_to_server": true,
      "path": "apps/wolinex",
      "sub_branch": "stack/web-client",
      "description": "Sovereign conversational interface, collaborative workspace, and MCP Hub UI",
      "ports": [8081],
      "healthcheck": "http://localhost:8081/health",
      "build": {
        "type": "node_python",
        "command": "packaging/wolinex/build.sh --components web",
        "script": "apps/wolinex/run_webui.sh",
        "image": "wolinet-web-client:latest"
      },
      "installer": {
        "role": "server",
        "boot_stage": 4,
        "builder": "packaging/wolinex/build.sh --components web",
        "script": "scripts/install-wolinex-web.sh",
        "artifacts_dir": "dist/installers/server/wolinex-web"
      }
    },
    {
      "id": "dev-portal",
      "name": "Wolinet Developer Portal",
      "category": "web_app",
      "deployable_to_server": true,
      "path": "apps/dev-portal",
      "sub_branch": "stack/dev-portal",
      "description": "Interactive developer documentation, API key onboarding, and playground",
      "ports": [8082],
      "healthcheck": "http://localhost:8082/healthz",
      "build": {
        "type": "static_nginx",
        "image": "wolinet-dev-portal:latest",
        "dockerfile": "apps/dev-portal/Dockerfile"
      }
    },
    {
      "id": "docs",
      "name": "Wolinet API Documentation & Copilot",
      "category": "web_app",
      "deployable_to_server": true,
      "path": "apps/docs",
      "sub_branch": "stack/docs",
      "description": "Scalar API reference, interactive sandbox, and domain documentation copilot",
      "ports": [8083],
      "healthcheck": "http://localhost:8083/healthz",
      "build": {
        "type": "static_nginx",
        "image": "wolinet-docs:latest",
        "dockerfile": "apps/docs/Dockerfile"
      }
    },
    {
      "id": "homepage",
      "name": "Wolinet Homepage & Showcase",
      "category": "web_app",
      "deployable_to_server": true,
      "path": "apps/website",
      "sub_branch": "stack/homepage",
      "description": "Enterprise sovereign showcase, landing page, and product documentation",
      "ports": [80, 8080, 3000],
      "build": {
        "type": "static_nginx",
        "image": "wolinet-homepage:latest",
        "dockerfile": "apps/website/Dockerfile"
      }
    },
    {
      "id": "orchestrator",
      "name": "Wolinet DEC & Orchestrator",
      "category": "server_core",
      "deployable_to_server": true,
      "path": "orchestrator",
      "sub_branch": "stack/orchestrator",
      "description": "DEC sovereign OS control plane (1Panel Go core, AI portal, AppStore, Podman Quadlets)",
      "ports": [8888, 9999, 8089],
      "healthcheck": "http://localhost:8888/",
      "build": {
        "type": "go_binary",
        "output": "bin/1apanel",
        "command": "packaging/orchestrator/build.sh"
      },
      "installer": {
        "role": "server",
        "boot_stage": 1,
        "builder": "packaging/orchestrator/build.sh",
        "script": "scripts/install-orchestrator.sh",
        "artifacts_dir": "dist/installers/server/orchestrator"
      }
    },
    {
      "id": "memory",
      "name": "Wolinet Memory Service",
      "category": "server_core",
      "deployable_to_server": true,
      "path": "services/litellm-memory",
      "sub_branch": "stack/memory",
      "description": "ai-memory persistent vector & cross-session continuity daemon",
      "ports": [49374],
      "healthcheck": "http://localhost:49374/health",
      "build": {
        "type": "python_daemon",
        "script": "services/litellm-memory/start-memory.sh",
        "image": "wolinet-memory:latest"
      }
    },
    {
      "id": "wolinex-ide",
      "name": "Wolinex Workstation (Sovereign Desktop AI Workstation)",
      "category": "client_desktop",
      "deployable_to_server": false,
      "path": "apps/WolinexIde",
      "sub_branch": "stack/wolinex-ide",
      "description": "Sovereign desktop workstation bundling Goose agentic core, Goosetown swarm orchestration, MCP Apps, mobile simulator, and Lango LiteLLM proxy",
      "api_dependency": "Connects via Lango LiteLLM Gateway (:4000/v1 or hosted Lango)",
      "build": {
        "type": "electron_forge",
        "command": "packaging/wolinex/build.sh --components cli,desktop"
      },
      "installer": {
        "role": "client_download",
        "builder": "packaging/wolinex/build.sh --components cli,desktop",
        "script": "scripts/install-wolinex-client.sh",
        "artifacts_dir": "dist/downloads/desktop"
      }
    },
    {
      "id": "wolinex-code",
      "name": "Wolinex Code (Sovereign Rust Full-Stack IDE)",
      "category": "client_desktop",
      "deployable_to_server": false,
      "path": "apps/ide",
      "sub_branch": "stack/wolinex-code",
      "description": "High-performance Rust IDE engine (OpenIDEA) featuring Tree-sitter AST, LSP for 60+ languages, DAP debugging, integrated terminal, and ACP agent pairing",
      "api_dependency": "Connects via Lango LiteLLM Gateway (:4000/v1) and local Goose ACP",
      "build": {
        "type": "rust_vite",
        "command": "cd apps/ide && pnpm run build"
      }
    },
    {
      "id": "wolinex",
      "name": "Wolinet Wolinex Model Ops",
      "category": "model_asset",
      "deployable_to_server": false,
      "path": "models",
      "sub_branch": "stack/wolinex",
      "description": "Sovereign model checkpoints (Wolinet Pro, Coder v2), registrations, and self-training pipelines",
      "build": {
        "type": "model_manifest",
        "command": "python3 scripts/self_training/register_checkpoint.py"
      }
    },
    {
      "id": "sdks",
      "name": "Wolinet Developer SDKs",
      "category": "sdk_package",
      "deployable_to_server": false,
      "path": "packages",
      "sub_branch": "stack/sdks",
      "description": "Official client SDK libraries for Python, Go, and TypeScript/JavaScript",
      "api_dependency": "Connects via REST to Lango Gateway (:4000/v1)",
      "build": {
        "type": "multi_sdk",
        "packages": [
          "packages/wolinet-python",
          "packages/wolinet-go",
          "packages/wolinet-sdk"
        ]
      }
    },
    {
      "id": "ide-tools",
      "name": "Wolinet Agentic Tools & Skills",
      "category": "tooling",
      "deployable_to_server": true,
      "path": "tools",
      "sub_branch": "stack/ide-tools",
      "description": "Claude / Antigravity agentic skill packs (ECC, curvine, scientific agent skills, rules)",
      "build": {
        "type": "skill_manifest"
      }
    },
    {
      "id": "ingress",
      "name": "Wolinet Edge Ingress",
      "category": "server_core",
      "deployable_to_server": true,
      "path": "nginx",
      "sub_branch": "stack/ingress",
      "description": "Edge reverse proxy, SSL termination, domain routing to internal services",
      "ports": [80, 443],
      "build": {
        "type": "container",
        "image": "wolinet-nginx:latest"
      }
    }
  ]
}
