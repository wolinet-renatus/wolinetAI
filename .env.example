# ==============================================================================
# Wolinet AI Platform - Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Gateway Configuration
UI_USERNAME=admin
UI_PASSWORD=sk-wolinet-master-key-change-me
WOLINET_GATEWAY_HOST=0.0.0.0
WOLINET_GATEWAY_PORT=4000
WOLINET_GATEWAY_MASTER_KEY=sk-wolinet-master-key-change-me
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/litellm
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
LITELLM_DISABLE_NO_REDIS_WARNING=true

# Local Inference Engine
XINFERENCE_HOST=127.0.0.1
XINFERENCE_PORT=9997

# Wolinet Local Provider (used by gateway/config.yaml via os.environ)
WOLINET_API_KEY=not-needed
WOLINET_API_BASE=http://127.0.0.1:9997/v1
WOLINET_INFERENCE_URL=http://127.0.0.1:9997
LITELLM_MASTER_KEY=sk-wolinet-master-key-change-me
STORE_MODEL_IN_DB=true

# ------------------------------------------------------------------------------
# Cloud Provider API Keys (Tier 2 & 3 Heavy Compute / Fallback)
# ------------------------------------------------------------------------------
# Frontier Reasoning
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cloud Video Generation Providers (Kling, Runway, Fal, Replicate)
KLING_API_KEY=
RUNWAY_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
