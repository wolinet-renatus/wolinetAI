[Container]
ContainerName=wolinet-browser
Pod=wolinetai-core-pod
Image=ghcr.io/wolinet-renatus/wolinet-browser:latest
Volume=/var/lib/wolinet/data/obscura:/data:Z
Environment=OBSCURA_ALLOW_ANONYMOUS_MCP=1
Environment=OBSCURA_SEARCH_INDEX_DIR=/data/search_index
Environment=PORT=8085
Exec=mcp --http --host 127.0.0.1 --port 8085 --stealth

[Service]
Restart=always

[Install]
WantedBy=default.target
