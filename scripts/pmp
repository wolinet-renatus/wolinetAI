#!/usr/bin/env bash
# ==============================================================================
# Wolinet Platform Package Manager (PMP)
# Unified Package & SDK Automation CLI for Wolinet AI Sovereign Ecosystem
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="${WORKSPACE_ROOT:-$(cd "${SCRIPT_DIR}/.." && pwd)}"

COLOR_RESET="\033[0m"
COLOR_CYAN="\033[36m"
COLOR_GREEN="\033[32m"
COLOR_YELLOW="\033[33m"
COLOR_RED="\033[31m"
COLOR_BOLD="\033[1m"

log_info() { echo -e "${COLOR_CYAN}ℹ [pmp]${COLOR_RESET} $*"; }
log_success() { echo -e "${COLOR_GREEN}✔ [pmp]${COLOR_RESET} $*"; }
log_warn() { echo -e "${COLOR_YELLOW}⚠ [pmp]${COLOR_RESET} $*"; }
log_error() { echo -e "${COLOR_RED}✖ [pmp]${COLOR_RESET} $*" >&2; }

# Paths to packages
PY_PKG="${WORKSPACE_ROOT}/packages/wolinet-python"
TS_PKG="${WORKSPACE_ROOT}/packages/wolinet-sdk"
GO_PKG="${WORKSPACE_ROOT}/packages/wolinet-go"

show_banner() {
    cat << "EOF"
  ██████╗ ███╗   ███╗██████╗ 
  ██╔══██╗████╗ ████║██╔══██╗
  ██████╔╝██╔████╔██║██████╔╝
  ██╔═══╝ ██║╚██╔╝██║██╔═══╝ 
  ██║     ██║ ╚═╝ ██║██║     
  ╚═╝     ╚═╝     ╚═╝╚═╝     
  Wolinet Platform Package Manager (v1.1.0)
EOF
}

cmd_help() {
    show_banner
    cat << EOF
Usage: pmp <command> [target] [options]

Core Commands:
  status               Inspect status, versions, and paths of all Wolinet SDKs
  build [target]       Build SDK distributions (targets: all, python, ts, go)
  test [target]        Run test suites across SDKs (targets: all, python, ts, go)
  install [target]     Install SDK packages into environment (targets: all, python, ts, go)
  pack [target]        Bundle release artifacts into dist/packages/
  generate             Regenerate all SDKs from live OpenAPI schema
  link                 Symlink 'pmp' binary into ~/.local/bin or /usr/local/bin

Targets:
  all                  All SDK packages (Default)
  python, py           Python Client SDK (packages/wolinet-python)
  ts, js, node         TypeScript / JavaScript SDK (packages/wolinet-sdk)
  go                   Go Language SDK (packages/wolinet-go)

Examples:
  pmp status
  pmp test all
  pmp install python
  pmp build ts
EOF
}

cmd_status() {
    show_banner
    echo -e "${COLOR_BOLD}Wolinet AI Sovereign Client SDKs Status:${COLOR_RESET}"
    echo "--------------------------------------------------------"

    # Python
    if [ -d "${PY_PKG}" ]; then
        py_ver=$(grep -E '^version\s*=' "${PY_PKG}/pyproject.toml" | head -n 1 | cut -d'"' -f2 || echo "1.1.0")
        echo -e "  🐍 ${COLOR_BOLD}Python SDK (wolinet):${COLOR_RESET}        v${py_ver}  [${COLOR_GREEN}READY${COLOR_RESET}] (${PY_PKG})"
    else
        echo -e "  🐍 Python SDK:                  [${COLOR_RED}MISSING${COLOR_RESET}]"
    fi

    # TypeScript
    if [ -d "${TS_PKG}" ]; then
        ts_ver=$(grep -E '"version":' "${TS_PKG}/package.json" | head -n 1 | cut -d'"' -f4 || echo "1.1.0")
        echo -e "  🟦 ${COLOR_BOLD}TypeScript SDK (@wolinet/sdk):${COLOR_RESET} v${ts_ver}  [${COLOR_GREEN}READY${COLOR_RESET}] (${TS_PKG})"
    else
        echo -e "  🟦 TypeScript SDK:              [${COLOR_RED}MISSING${COLOR_RESET}]"
    fi

    # Go
    if [ -d "${GO_PKG}" ]; then
        echo -e "  🐹 ${COLOR_BOLD}Go SDK (wolinet-go):${COLOR_RESET}          v1.1.0  [${COLOR_GREEN}READY${COLOR_RESET}] (${GO_PKG})"
    else
        echo -e "  🐹 Go SDK:                      [${COLOR_RED}MISSING${COLOR_RESET}]"
    fi
    echo "--------------------------------------------------------"
}

build_python() {
    log_info "Building Python SDK package..."
    (cd "${PY_PKG}" && python3 -m pip install --upgrade build >/dev/null 2>&1 || true)
    (cd "${PY_PKG}" && python3 -m build --sdist --wheel --outdir "${WORKSPACE_ROOT}/dist/packages/python" >/dev/null 2>&1 || {
        log_warn "Standard build tool not present, verifying python syntax & egg structure..."
        python3 -m compileall "${PY_PKG}/wolinet" >/dev/null
    })
    log_success "Python SDK build verified."
}

build_ts() {
    log_info "Building TypeScript SDK (@wolinet/sdk)..."
    (cd "${TS_PKG}" && npm run build)
    log_success "TypeScript SDK compilation completed (dist/index.js, dist/index.d.ts)."
}

build_go() {
    log_info "Verifying Go SDK (wolinet-go)..."
    (cd "${GO_PKG}" && go vet ./...)
    log_success "Go SDK syntax and type verification passed."
}

cmd_build() {
    local target="${1:-all}"
    case "$target" in
        all)
            build_ts
            build_python
            build_go
            ;;
        python|py)
            build_python
            ;;
        ts|js|node)
            build_ts
            ;;
        go)
            build_go
            ;;
        *)
            log_error "Unknown build target: $target. Choose from: all, python, ts, go"
            exit 1
            ;;
    esac
}

test_python() {
    log_info "Running Python SDK test suite..."
    local py_bin="python3"
    if [ -f "${WORKSPACE_ROOT}/.venv/bin/python3" ]; then
        py_bin="${WORKSPACE_ROOT}/.venv/bin/python3"
    fi
    PYTHONPATH="${PY_PKG}" "${py_bin}" -m unittest discover -s "${PY_PKG}/tests" -v
    log_success "Python SDK tests passed."
}

test_ts() {
    log_info "Running TypeScript SDK test suite..."
    (cd "${TS_PKG}" && npm test)
    log_success "TypeScript SDK tests passed."
}

test_go() {
    log_info "Running Go SDK test suite..."
    (cd "${GO_PKG}" && go test -v ./...)
    log_success "Go SDK tests passed."
}

cmd_test() {
    local target="${1:-all}"
    case "$target" in
        all)
            test_ts
            test_go
            test_python
            log_success "All SDK test suites passed cleanly!"
            ;;
        python|py)
            test_python
            ;;
        ts|js|node)
            test_ts
            ;;
        go)
            test_go
            ;;
        *)
            log_error "Unknown test target: $target. Choose from: all, python, ts, go"
            exit 1
            ;;
    esac
}

install_python() {
    log_info "Installing Wolinet Python SDK in editable mode..."
    pip3 install -e "${PY_PKG}" || python3 -m pip install -e "${PY_PKG}"
    log_success "Python SDK installed: 'import wolinet' is active."
}

install_ts() {
    log_info "Linking TypeScript SDK globally via npm..."
    (cd "${TS_PKG}" && npm link)
    log_success "TypeScript SDK linked: available via '@wolinet/sdk'."
}

install_go() {
    log_info "Go SDK is module-ready. In your Go projects, run:"
    echo -e "    ${COLOR_CYAN}go get github.com/wolinet/wolinet-go${COLOR_RESET}"
    echo "Or replace locally in go.mod with: replace github.com/wolinet/wolinet-go => ${GO_PKG}"
    log_success "Go SDK configured."
}

cmd_install() {
    local target="${1:-all}"
    case "$target" in
        all)
            install_python
            install_ts
            install_go
            ;;
        python|py)
            install_python
            ;;
        ts|js|node)
            install_ts
            ;;
        go)
            install_go
            ;;
        *)
            log_error "Unknown install target: $target. Choose from: all, python, ts, go"
            exit 1
            ;;
    esac
}

cmd_pack() {
    log_info "Packaging all SDK release distributions into dist/packages/..."
    mkdir -p "${WORKSPACE_ROOT}/dist/packages/npm"
    mkdir -p "${WORKSPACE_ROOT}/dist/packages/python"
    
    # 1. Build TS and pack tarball
    (cd "${TS_PKG}" && npm run build && npm pack --pack-destination="${WORKSPACE_ROOT}/dist/packages/npm")
    
    # 2. Build Python wheels
    build_python

    log_success "Packaged release distributions generated in dist/packages/."
    ls -lh "${WORKSPACE_ROOT}/dist/packages/"*/* 2>/dev/null || true
}

cmd_generate() {
    log_info "Triggering SDK code generator..."
    python3 "${WORKSPACE_ROOT}/scripts/generate_sdk.py" --lang all
    log_success "SDK code generation completed."
}

cmd_link() {
    log_info "Installing pmp binary to local PATH..."
    local dest_dir=""
    if [ -d "${HOME}/.local/bin" ] || mkdir -p "${HOME}/.local/bin" 2>/dev/null; then
        dest_dir="${HOME}/.local/bin"
    elif [ -w "/usr/local/bin" ]; then
        dest_dir="/usr/local/bin"
    else
        dest_dir="${WORKSPACE_ROOT}/bin"
    fi

    mkdir -p "${dest_dir}"
    ln -sf "${SCRIPT_DIR}/pmp" "${dest_dir}/pmp"
    log_success "Linked 'pmp' command to ${dest_dir}/pmp"
    echo -e "You can now run ${COLOR_BOLD}'pmp status'${COLOR_RESET} from your shell."
}

# CLI Router
COMMAND="${1:-status}"
shift || true

case "${COMMAND}" in
    status)
        cmd_status
        ;;
    build)
        cmd_build "${1:-all}"
        ;;
    test)
        cmd_test "${1:-all}"
        ;;
    install)
        cmd_install "${1:-all}"
        ;;
    pack)
        cmd_pack
        ;;
    generate)
        cmd_generate
        ;;
    link)
        cmd_link
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        log_error "Unknown command: ${COMMAND}"
        cmd_help
        exit 1
        ;;
esac
