#!/usr/bin/env bash
# ==============================================================================
# Wolinet AI - CLI Launcher
# Native terminal agent powered by Charm Crush & Wolinet Gateway
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
BIN_PATH="${SCRIPT_DIR}/wolinet-cli"

# Load environment configuration if available
if [ -f "${ROOT_DIR}/.env" ]; then
    set -o allexport
    source "${ROOT_DIR}/.env"
    set +o allexport
fi

export LITELLM_BASE_URL="${LITELLM_BASE_URL:-http://127.0.0.1:4000/v1}"
export LITELLM_API_KEY="${LITELLM_API_KEY:-sk-wolinet-admin-2026}"

if [ ! -x "${BIN_PATH}" ]; then
    echo "[Wolinet CLI] Building binary from vendored source..."
    (cd "${SCRIPT_DIR}" && go build -mod=vendor -o "${BIN_PATH}" .)
fi

# Ensure .crushrc is used if no custom config specified
if [ ! -f "${HOME}/.config/crush/crushrc" ] && [ -f "${SCRIPT_DIR}/.crushrc" ]; then
    mkdir -p "${HOME}/.config/crush"
    cp "${SCRIPT_DIR}/.crushrc" "${HOME}/.config/crush/crushrc"
fi

exec "${BIN_PATH}" "$@"
